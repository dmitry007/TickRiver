<Window x:Class="TickRiver.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TickRiver" Title="TickRiver" Icon="Assets/TickRiver.ico" Width="1320" Height="860" MinWidth="1020" MinHeight="640" Background="#F3F6F8" WindowStartupLocation="CenterScreen">
  <Grid Background="#F3F6F8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#DFE7EC" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="26,30,20,24"><TextBlock Text="◷ TickRiver" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Your time, flowing freely." Foreground="#788C98" Margin="0,9,0,0" /></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,20"><TextBlock Text="LOCAL WORKSPACE" FontSize="11" Foreground="#788C98" Margin="7,0,0,10" /><Button Content="AI connections…" Click="ConnectionsClick" Margin="4,0,4,10" /><Button Content="Back up data…" Click="BackupClick" /><Button Content="Exit TickRiver" Click="ExitClick" Margin="4,10,4,0" /></StackPanel>
        <StackPanel>
          <RadioButton x:Name="TrackerNav" GroupName="Navigation" Content="◷   Time Tracker" Style="{StaticResource Nav}" Tag="Tracker" Checked="Navigate" />
          <RadioButton x:Name="ReportsNav" GroupName="Navigation" Content="▥   Reports" Style="{StaticResource Nav}" Tag="Reports" Checked="Navigate" />
          <TextBlock Text="MANAGE" Margin="30,30,0,10" Foreground="#788C98" FontSize="11" />
          <RadioButton x:Name="ClientsNav" GroupName="Navigation" Content="♙   Clients" Style="{StaticResource Nav}" Tag="Clients" Checked="Navigate" />
          <RadioButton x:Name="ProjectsNav" GroupName="Navigation" Content="▤   Projects" Style="{StaticResource Nav}" Tag="Projects" Checked="Navigate" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22"><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Saved on this computer" Foreground="#788C98" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
      <Grid x:Name="TrackerPage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DDE6EB" BorderThickness="1" CornerRadius="5" Padding="22">
          <StackPanel><TextBlock Text="WHAT ARE YOU WORKING ON?" Foreground="#788C98" FontSize="11" Margin="0,0,0,10" /><TextBox x:Name="DescriptionBox" FontSize="17" ToolTip="Optional description" AutomationProperties.Name="Work description" />
            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox x:Name="TimerProject" DisplayMemberPath="DisplayName" AutomationProperties.Name="Timer project" MinWidth="260" />
              <Button Grid.Column="1" Content="+ Project" Click="NewProjectClick" Margin="10,0" />
              <TextBlock Grid.Column="2" x:Name="TimerLabel" Text="00:00:00" FontSize="26" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
              <Button Grid.Column="3" x:Name="TimerButton" Content="START" Style="{StaticResource Primary}" Click="TimerClick" MinWidth="100" />
            </Grid>
          </StackPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,24,0,14"><TextBlock x:Name="WeekTotal" FontSize="17" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Add time" Click="AddTimeClick" /><Button Content="Edit entry" Click="EditEntryClick" /><Button Content="Continue" Click="ContinueClick" /><Button Content="Delete" Click="DeleteEntryClick" /></StackPanel></DockPanel>
        <Grid Grid.Row="2"><DataGrid x:Name="EntriesGrid" MouseDoubleClick="EditEntryClick">
          <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#E5EDF1" Padding="12,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
          <DataGrid.Columns><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" /><DataGridTextColumn Header="Project · Client" Binding="{Binding ProjectLabel}" Width="240" /><DataGridTextColumn Header="Start" Binding="{Binding StartLabel}" Width="90" /><DataGridTextColumn Header="End" Binding="{Binding EndLabel}" Width="90" /><DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="110" /><DataGridTextColumn Header="Billing" Binding="{Binding BillingLabel}" Width="100" /></DataGrid.Columns>
        </DataGrid><TextBlock x:Name="TrackerEmpty" Text="Create a client and project, then press Start. No tasks required." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#788C98" FontSize="16" /></Grid>
      </Grid>
      <Grid x:Name="ReportsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,14"><ComboBox x:Name="RangePreset" Width="160" SelectionChanged="PresetChanged" /><Button x:Name="PreviousRangeButton" Content="‹" Click="PreviousRange" /><DatePicker x:Name="FromDate" Width="140" AutomationProperties.Name="Report start date" SelectedDateChanged="CustomDateChanged" /><TextBlock Text="to" VerticalAlignment="Center" Margin="10,0" /><DatePicker x:Name="ToDate" Width="140" AutomationProperties.Name="Report end date" SelectedDateChanged="CustomDateChanged" /><Button x:Name="NextRangeButton" Content="›" Click="NextRange" /><Button Content="Apply" Style="{StaticResource Primary}" Click="ApplyReport" /></WrapPanel>
        <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="4" Margin="0,0,0,18"><WrapPanel><ComboBox x:Name="ClientFilter" Width="190" Margin="0,0,12,0" DisplayMemberPath="Name" SelectionChanged="ClientFilterChanged" /><ComboBox x:Name="ProjectFilter" Width="230" DisplayMemberPath="DisplayName" /><CheckBox x:Name="UnbilledFilter" Content="Unbilled only" VerticalAlignment="Center" Margin="18,0" /><Button Content="Filter" Click="ApplyReport" /></WrapPanel></Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="ReportTotal" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="ReportAmount" Foreground="#788C98" Margin="0,5,0,0" /></StackPanel><WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Export PNG…" Click="ExportPng" /><Button Content="Export Excel…" Click="ExportExcel" />
          <Border BorderBrush="#CDD9E0" BorderThickness="1" CornerRadius="4" Background="White" Margin="4,0"><StackPanel Orientation="Horizontal">
            <Button x:Name="CopyDataButton" Content="Copy data" Click="CopyReportData" Margin="0" ToolTip="Copy the displayed detailed entries as a table for Word or Excel"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EAF0F3" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
            <Border BorderBrush="#CDD9E0" BorderThickness="1,0,0,0"><Button x:Name="CopyColumnsButton" Content="▾" Click="ChooseCopyColumns" Margin="0" Padding="9,9" ToolTip="Choose columns to copy" AutomationProperties.Name="Choose columns to copy"><Button.ContextMenu><ContextMenu x:Name="CopyColumnsMenu" Placement="Bottom" /></Button.ContextMenu></Button></Border>
          </StackPanel></Border>
          <Button Content="Mark invoiced" Click="MarkInvoiced" /></WrapPanel></DockPanel>
        <TabControl x:Name="ReportTabs" Grid.Row="3" Background="White" BorderBrush="#DDE6EB" Padding="0">
          <TabItem Header="   Summary   "><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="ChartTitle" FontSize="17" FontWeight="SemiBold" Margin="22,20,22,0" /><local:HoursChart x:Name="Chart" Margin="12,0" /><TextBlock Text="Click a day’s bar to see its time entries. Zero-work days remain visible." Foreground="#788C98" Margin="22,8,22,20" /></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="   Detailed   "><DataGrid x:Name="ReportGrid" MouseDoubleClick="EditReportEntry"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="110" /><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" /><DataGridTextColumn Header="Project · Client" Binding="{Binding ProjectLabel}" Width="190" /><DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" /><DataGridTextColumn Header="Decimal h" Binding="{Binding DecimalHours, StringFormat=N6}" Width="100" /><DataGridTextColumn Header="Amount" Binding="{Binding AmountLabel}" Width="100" /><DataGridTextColumn Header="Billing" Binding="{Binding BillingLabel}" Width="90" /></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
      </Grid>
      <Grid x:Name="ClientsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><TextBlock Text="Default rates apply to new time entries." VerticalAlignment="Center" Foreground="#788C98" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Client" Style="{StaticResource Primary}" Click="NewClientClick" /><Button Content="Edit client" Click="EditClientClick" /></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="ClientsGrid" MouseDoubleClick="EditClientClick"><DataGrid.Columns><DataGridTextColumn Header="Client / Company" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="140" /><DataGridTextColumn Header="Hourly rate" Binding="{Binding Rate, StringFormat=N2}" Width="170" /><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" /></DataGrid.Columns></DataGrid></Grid>
      <Grid x:Name="ProjectsPage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><TextBlock Text="Use the client’s rate, or set a project override." VerticalAlignment="Center" Foreground="#788C98" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Project" Style="{StaticResource Primary}" Click="NewProjectClick" /><Button Content="Edit project" Click="EditProjectClick" /></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="ProjectsGrid" MouseDoubleClick="EditProjectClick"><DataGrid.Columns><DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="200" /><DataGridTextColumn Header="Hourly rate" Binding="{Binding RateLabel}" Width="280" /><DataGridCheckBoxColumn Header="Billable" Binding="{Binding Billable}" Width="90" /><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" /></DataGrid.Columns></DataGrid></Grid>
      <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0" Foreground="#788C98" Text="Ready" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
