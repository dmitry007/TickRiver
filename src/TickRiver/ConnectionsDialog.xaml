<Window x:Class="TickRiver.ConnectionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI connections" Icon="Assets/TickRiver.ico" Width="780" Height="720" MinWidth="560" MinHeight="420" Background="#F3F6F8" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="#F3F6F8">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DFE7EC" BorderThickness="0,0,0,1" Padding="26,18">
      <StackPanel>
        <TextBlock Text="AI connections" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Use your AI client with TickRiver's local time data." Foreground="#617784" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="26,16">
        <Border Background="White" BorderBrush="#DFE7EC" BorderThickness="1" CornerRadius="8">
          <StackPanel>
            <Grid Margin="16,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="124" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="HOST" FontSize="11" FontWeight="SemiBold" Foreground="#617784" />
              <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#617784" />
              <TextBlock Grid.Column="2" Text="DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="#617784" />
            </Grid>
            <ItemsControl x:Name="Connections">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E7EDF1" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="124" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Host}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                      <Border Grid.Column="1" Background="{Binding Background}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" Foreground="{Binding Foreground}" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground}" />
                        </StackPanel>
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#617784" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="Status reflects local configuration. Restart or reconnect your AI client after setup changes." Foreground="#617784" FontSize="12" TextWrapping="Wrap" Margin="2,10,2,20" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
          <Border Background="#E3F3F1" CornerRadius="8" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Try asking" FontSize="16" FontWeight="SemiBold" Foreground="#007C78" Margin="0,0,0,12" />
              <TextBlock Text="“What were my hours last week?”" TextWrapping="Wrap" Foreground="#007C78" />
              <TextBlock Text="“Start the timer for Website maintenance.”" TextWrapping="Wrap" Foreground="#007C78" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="White" BorderBrush="#DFE7EC" BorderThickness="1" CornerRadius="8" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Access &amp; privacy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
              <TextBlock TextWrapping="Wrap" FontSize="13"><Run Text="Reports " FontWeight="SemiBold" /><Run Text="are read-only." Foreground="#617784" /></TextBlock>
              <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"><Run Text="Timers &amp; edits: " FontWeight="SemiBold" /><Run Text="start or stop tracking and edit completed entries when requested." Foreground="#617784" /></TextBlock>
              <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"><Run Text="Data sharing: " FontWeight="SemiBold" /><Run Text="requested data is returned to your AI client and may be processed by its provider." Foreground="#617784" /></TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#DFE7EC" BorderThickness="0,1,0,0" Padding="22,14">
      <Button x:Name="CloseButton" Content="Done" Style="{StaticResource Primary}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Click="CloseClick" />
    </Border>
  </Grid>
</Window>
